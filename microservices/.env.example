# ── IoBuild — Variables de Entorno ──
#
# Instrucciones:
#   1. Copia este archivo a .env:   cp .env.example .env
#   2. Edita .env con tus credenciales reales
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
#
# ──────────────────────────────────────────────────

# ── MySQL ──
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=iobuild123

# ── JWT Secret (mínimo 32 caracteres) ──
JWT_SECRET=iobuild-super-secret-key-minimum-32-chars!!-dev

# ── InfluxDB (telemetría IoT) ──
INFLUXDB_TOKEN=iobuild-telemetry-token-dev
INFLUXDB_PASSWORD=admin123

# ── MQTT (broker de mensajería IoT) ──
MQTT_HOST=mosquitto
MQTT_PORT=1883

# ── Stripe (opcional, para suscripciones y pagos) ──
# Obtén estas keys desde https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Webhook secret para validar firma HMAC de Stripe
# Desde Stripe Dashboard → Developers → Webhooks → Add endpoint
# URL: https://tu-dominio.com/api/v1/webhooks/stripe
# Eventos: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ── IoT Simulator ──
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_INTERVAL_SECONDS=5
